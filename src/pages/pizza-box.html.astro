---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import pizzas from '../data/pizzas.json';
import '../styles/cakes.css';
const groups = [...new Set(pizzas.flatMap(p => p.groups))];
---
<Base title="Pizza Boxes — Printed, Kraft & Corrugated Packaging | Vaniga" description="Explore 14 pizza packaging listings with photos, dimensions and specifications. Supplied by Vaniga, your packaging supplier and exporter.">
  <Header />
  <main id="top" class="cake-shell">
    <nav class="cake-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#products">Products</a><span>/</span><span>Pizza boxes</span></nav>
    <section class="cake-intro"><div><div class="eyebrow">THE PIZZERIA EDIT</div><h1>Good pizza deserves<br />a great box.</h1></div><p>Printed, plain, kraft and corrugated packaging. Compare sizes and materials, explore every product photo, and find a box for your brand.</p></section>
    <div class="cake-toolbar" id="collection"><div class="cake-filter"><label for="cake-category">Explore the collection</label><select id="cake-category"><option value="all">All pizza boxes</option>{groups.map(group => <option>{group}</option>)}</select></div><span class="cake-count" id="cake-count" aria-live="polite">14 product listings</span></div>
    <div class="cake-list">
      {pizzas.map((p, i) => <article class="cake-item" data-groups={p.groups.join('|')}>
        <a href={`/pizza-box/${p.id}/`} class="cake-photo" aria-label={`View ${p.title}`}><img src={`/images/pizza/${p.image}`} alt={p.title} width="250" height="250" loading={i < 2 ? 'eager' : 'lazy'} /></a>
        <div><div class="eyebrow">{p.group}</div><h2><a href={`/pizza-box/${p.id}/`}>{p.title}</a></h2><p class="cake-spec-preview">{p.size ?? (p.note ? 'Size available on confirmation' : 'Ask for available sizes')}<br />{[p.gsm, p.material ?? p.finish].filter(Boolean).join(' · ')}</p><a class="text-link" href={`/pizza-box/${p.id}/`}>Explore this box <Icon name="arrow-up-right" size={16} /></a></div>
      </article>)}
    </div>
    <section class="cake-custom"><div><h2>Your pizza. Your brand. Your box.</h2><p>Need a different size or your logo in print? Tell us what you have in mind.</p></div><a href="/#quote" class="btn btn-accent">Discuss custom packaging <Icon name="arrow" /></a></section>
  </main><Footer />
</Base>
<script>
  const category = document.getElementById('cake-category') as HTMLSelectElement;
  const applyCategory = () => {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.cake-item').forEach(item => {
      item.hidden = category.value !== 'all' && !(item.dataset.groups ?? '').split('|').includes(category.value);
      if (!item.hidden) visible++;
    });
    const count = document.getElementById('cake-count');
    if (count) count.textContent = `${visible} product ${visible === 1 ? 'listing' : 'listings'}`;
  };
  const initial = new URLSearchParams(window.location.search).get('category');
  if (initial && [...category.options].some(option => option.value === initial)) category.value = initial;
  applyCategory();
  category?.addEventListener('change', () => {
    applyCategory();
    const url = new URL(window.location.href);
    if (category.value === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', category.value);
    window.history.replaceState(null, '', url);
  });
</script>
