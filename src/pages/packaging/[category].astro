---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import products from '../../data/packaging.json';
import {collections} from '../../data/collections';
import '../../styles/cakes.css';
export function getStaticPaths(){return collections.map(collection=>({params:{category:collection.id},props:{collection}}));}
const {collection}=Astro.props;
const items=products.filter(p=>p.category===collection.id);
const groups=[...new Set(items.map(p=>p.group))];
---
<Base title={`${collection.title} | Vaniga Packaging`} description={collection.intro}>
<Header/><main id="top" class="cake-shell">
<nav class="cake-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/packaging/">All packaging</a><span>/</span><span>{collection.title}</span></nav>
<section class="cake-intro"><div><div class="eyebrow">THE PACKAGING COLLECTION</div><h1>{collection.title}</h1></div><p>{collection.intro}</p></section>
<div class="cake-toolbar" id="collection"><div class="cake-filter" hidden={groups.length < 2}><label for="packaging-category">Explore the collection</label><select id="packaging-category"><option value="all">All styles</option>{groups.map(group=><option>{group}</option>)}</select></div><span class="cake-count" id="packaging-count" aria-live="polite">{items.length} product listings</span></div>
<div class="cake-list">{items.map((p,i)=><article class="cake-item" data-group={p.group}><a class:list={["cake-photo", {"product-hover-preview": ["eco", "cartons"].includes(collection.id)}]} href={`/products/${p.id}/`} aria-label={`View ${p.title}`}><img src={`/images/packaging/${p.image}`} alt={p.title} width="500" height="500" loading={i<2?'eager':'lazy'}/></a><div><div class="eyebrow">{p.group}</div><h2><a href={`/products/${p.id}/`}>{p.title}</a></h2><p class="cake-spec-preview">{p.size ?? 'Confirm available sizes'}<br/>{p.material ?? 'Confirm board or material specifications'}</p><a class="text-link" href={`/products/${p.id}/`}>Explore this product <Icon name="arrow-up-right" size={16}/></a></div></article>)}</div>
{collection.id==='eco' && <p class="cake-note">Looking for paper or kraft containers? <a href="/products/paper-food-containers/">Compare 500 ml, 750 ml, 1000 ml and 2500 ml options.</a></p>}
<section class="cake-custom"><div><h2>Make it your own.</h2><p>Tell us your size, quantity and branding requirements.</p></div><a href={`/?product=${collection.id}#quote`} class="btn btn-accent">Discuss your packaging <Icon name="arrow"/></a></section>
<a href="/packaging/" class="text-link">Explore other collections <Icon name="arrow" size={16}/></a>
</main><Footer/>
</Base>
<script>
const select=document.getElementById('packaging-category') as HTMLSelectElement;
const apply=()=>{let count=0;document.querySelectorAll<HTMLElement>('.cake-item').forEach(item=>{item.hidden=select.value!=='all'&&item.dataset.group!==select.value;if(!item.hidden)count++;});document.getElementById('packaging-count')!.textContent=`${count} product ${count===1?'listing':'listings'}`;};
const initial=new URLSearchParams(location.search).get('category');if(initial&&[...select.options].some(o=>o.value===initial))select.value=initial;apply();select.addEventListener('change',()=>{apply();const url=new URL(location.href);if(select.value==='all')url.searchParams.delete('category');else url.searchParams.set('category',select.value);history.replaceState(null,'',url);});
</script>

<style>
.product-hover-preview img {transition:transform 220ms ease-out;}
@media (hover:hover) and (prefers-reduced-motion:no-preference) {
  .product-hover-preview:hover img, .product-hover-preview:focus-visible img {transform:perspective(900px) rotateX(5deg) rotateY(-8deg) scale(1.045);}
}
</style>
