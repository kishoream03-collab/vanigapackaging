---
import pizzas from '../../data/pizzas.json';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/packaging.json';
import cakes from '../../data/cakes';
import {collections} from '../../data/collections';
import '../../styles/cakes.css';
---
<Base title="All packaging collections | Vaniga" description="Explore cake, pizza, takeaway, container, eco, carton and gift packaging."><Header/><main class="cake-shell"><section class="cake-intro"><h1>Find your packaging.</h1><p>Explore by what you’re packing. Each collection includes product photos, listed specifications and a quote link.</p></section><div class="cake-related-grid"><a class="cake-related-link" href="/cake-box.html"><div class="cake-photo"><img src="/images/cake-box-render.webp" alt="Cake packaging" width="500" height="500"/></div><h2>Cake boxes</h2><span>{cakes.length} listings →</span></a><a class="cake-related-link" href="/pizza-box.html"><div class="cake-photo"><img src="/images/pizza-box-render.webp" alt="Pizza packaging" width="500" height="500"/></div><h2>Pizza boxes</h2><span>{pizzas.length} listings →</span></a>{collections.map(c=>{const items=products.filter(p=>p.category===c.id);return <a class="cake-related-link" href={`/packaging/${c.id}/`}><div class="cake-photo"><img src={`/images/packaging/${items[0].image}`} alt={c.title} width="500" height="500" loading="lazy"/></div><h2>{c.title}</h2><span>{items.length} listings →</span></a>;})}</div></main><Footer/></Base>
