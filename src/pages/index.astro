---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Products from '../components/Products.astro';
import Custom from '../components/Custom.astro';
import Why from '../components/Why.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Vaniga — Packaging Supplier & Exporter"
  description="Cake, pizza, burger and roll boxes, bagasse containers and printed mono cartons — plain or printed with your brand. Packaging sourced from trusted manufacturers for domestic and international customers."
>
  <Header />
  <main>
    <Hero />
    <Marquee />
    <Products />
    <Custom />
    <Why />
    <Quote />
  </main>
  <Footer />
</Base>
