---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ProductCarousel from '../../components/ProductCarousel.astro';
import products from '../../data/packaging.json';
import {collections} from '../../data/collections';
import '../../styles/cakes.css';
export function getStaticPaths(){return products.map(product=>({params:{id:product.id},props:{product}}));}
const {product}=Astro.props;
const collection=collections.find(c=>c.id===product.category)!;
const back=`/packaging/${collection.id}/`;
const related=products.filter(p=>p.category===product.category&&p.id!==product.id).slice(0,3);
---
<Base title={`${product.title} | Vaniga Packaging`} description={`Explore ${product.title}, product photos, specifications and custom packaging enquiries.`}>
<Header/><main id="top" class="cake-shell">
<nav class="cake-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={back}>{collection.title}</a><span>/</span><span>{product.title}</span></nav>
<a href={back} class="cake-back">← Back to {collection.title.toLowerCase()}</a>
<div class="cake-detail"><ProductCarousel title={product.title} images={product.gallery} folder="packaging"/><div><div class="eyebrow">{product.group}</div><h1>{product.title}</h1><p>Compare the listed specifications and tell us your size, quantity and printing requirements.</p><dl>{product.specifications.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>{product.note&&<p class="cake-note">{product.note}</p>}<p>Price on request</p><a href={`/?product=${product.id}#quote`} class="btn btn-accent">Get a quote for this product <Icon name="arrow"/></a></div></div>
<section class="cake-related"><h2>More products to explore</h2><div class="cake-related-grid">{related.map(p=><a class="cake-related-link" href={`/products/${p.id}/`}><div class="cake-photo"><img src={`/images/packaging/${p.image}`} alt={p.title} width="250" height="250" loading="lazy"/></div><h3>{p.title}</h3><span>View product <Icon name="arrow" size={16}/></span></a>)}</div></section>
<a href={back} class="text-link">Browse the collection <Icon name="arrow" size={16}/></a>
</main><Footer/>
</Base>
