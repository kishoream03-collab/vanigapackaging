---
import Icon from './Icon.astro';
import { industries } from '../data/site';

const cards = [
  { icon: 'shield', bg: 'var(--green)', fg: 'var(--card)', title: 'Food-grade, hygienic materials', body: 'Food boxes are made from certified food-grade material and handled hygienically.' },
  { icon: 'layers', bg: 'var(--ink)', fg: 'var(--paper)', title: 'Sourced from trusted manufacturers', body: 'We help you find packaging that suits your product, quantity and customization needs.' },
  { icon: 'tag', bg: 'var(--accent)', fg: 'var(--card)', title: 'Plain or printed, your size', body: 'Standard styles or custom dimensions, in plain kraft or branded with your artwork.' },
  { icon: 'layers', bg: 'var(--kraft)', fg: 'var(--ink)', title: '30+ products, one supplier', body: 'Boxes, cartons, containers and trays, all on a single order.' },
];
---
<section id="why" class="section">
  <div class="section-head">
    <div>
      <div class="eyebrow">03 — WHY VANIGA</div>
      <h2 class="h2">Your packaging sourcing partner.</h2>
    </div>
    <p style="max-width: 400px">One point of contact for packaging selection, customization and supply, serving domestic and international customers.</p>
  </div>

  <div class="why-grid">
    {cards.map((c) => (
      <div class="why-card">
        <span class="why-ico" style={`background:${c.bg};color:${c.fg}`}><Icon name={c.icon} size={22} stroke={1.8} /></span>
        <div><h3>{c.title}</h3><p>{c.body}</p></div>
      </div>
    ))}
  </div>

  <div class="trust">
    <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D8B988" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>INDIAMART TRUSTSEAL VERIFIED</span>
    <span>PROPRIETORSHIP</span>
    <span class="kraft">CHENNAI, INDIA</span>
  </div>

  <div id="industries" class="industries">
    <div class="industries-head"><h3>Who we pack for</h3><span class="eyebrow">BAKERIES TO BRANDS</span></div>
    <ul class="tags">
      {industries.map((i) => <li class={`tag ${i.tone}`}>{i.label}</li>)}
    </ul>
  </div>
</section>
