---
import Icon from './Icon.astro';
import { industries } from '../data/site';

const cards = [
  { icon: 'shield', bg: 'var(--green)', fg: 'var(--card)', title: 'Food-grade, hygienic materials', body: 'Food boxes are made from certified food-grade material and handled hygienically.' },
  { icon: 'layers', bg: 'var(--ink)', fg: 'var(--paper)', title: 'Sourced from trusted manufacturers', body: 'We help you find packaging that suits your product, quantity and customization needs.' },
  { icon: 'tag', bg: 'var(--accent)', fg: 'var(--card)', title: 'Plain or printed, your size', body: 'Standard styles or custom dimensions, in plain kraft or branded with your artwork.' },
  { icon: 'layers', bg: 'var(--kraft)', fg: 'var(--ink)', title: '30+ products, one supplier', body: 'Boxes, cartons, containers and trays, all on a single order.' },
];
---
<section id="why" class="section">
  <div class="section-head">
    <div>
      <div class="eyebrow">03 — WHY VANIGA</div>
      <h2 class="h2">Your packaging sourcing partner.</h2>
    </div>
    <p style="max-width: 400px">One point of contact for packaging selection, customization and supply, serving domestic and international customers.</p>
  </div>

  <div class="why-grid">
    {cards.map((c) => (
      <div class="why-card">
        <span class="why-ico" style={`background:${c.bg};color:${c.fg}`}><Icon name={c.icon} size={22} stroke={1.8} /></span>
        <div><h3>{c.title}</h3><p>{c.body}</p></div>
      </div>
    ))}
  </div>

  <div class="trust">
    <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D8B988" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>INDIAMART TRUSTSEAL VERIFIED</span>
    <span>PROPRIETORSHIP</span>
    <span class="kraft">CHENNAI, INDIA</span>
  </div>

  <div id="industries" class="industries" aria-labelledby="industries-title">
    <div class="industries-head"><h3 id="industries-title">Packaging for your business</h3><p>Find packaging for what you sell.</p></div>
    <ul class="industry-grid">
      {industries.map((industry, index) => <li><a class="industry-card" href={industry.href}>
        <div class="industry-card-top"><span class="industry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="industry-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={20}/></span></div>
        <div class="industry-card-copy"><h4>{industry.label}</h4><p>{industry.description}</p></div>
        <span class="industry-explore">Explore packaging <span aria-hidden="true">→</span></span>
      </a></li>)}
    </ul>
  </div>
</section>

<style>
  .industries-head > p { color:var(--muted);font-size:15px;line-height:1.5; }
  .industry-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:1fr;gap:18px;margin:0;padding:0;list-style:none; }
  .industry-card { position:relative;display:flex;flex-direction:column;gap:24px;min-height:248px;height:100%;padding:26px;background:linear-gradient(135deg,#fffcf6,#f2e9da);border:1px solid #ded4c3;border-radius:22px;color:var(--ink);text-decoration:none;box-shadow:0 3px 0 rgba(25,24,20,.025);transition:transform 220ms ease,box-shadow 220ms ease,background-color 220ms ease,border-color 220ms ease; }
  .industry-card-top { display:flex;align-items:center;justify-content:space-between;gap:16px; }
  .industry-number { font:500 13px var(--mono);letter-spacing:.12em;color:var(--accent-dark); }
  .industry-number::after { content:'';display:inline-block;width:28px;height:1px;background:currentColor;vertical-align:middle;margin-left:12px;opacity:.45; }
  .industry-arrow { display:flex;align-items:center;justify-content:center;width:38px;height:38px;flex-shrink:0;border:1px solid #d8cbb7;border-radius:50%;color:var(--accent-dark);background:rgba(255,252,246,.65);transition:transform 220ms ease,background-color 220ms ease; }
  .industry-arrow :global(svg) { display:block; }
  .industry-card-copy { flex:1; }
  .industry-card h4 { margin:0;font:600 24px/1.15 var(--display);letter-spacing:-.025em;max-width:300px; }
  .industry-card p { margin:12px 0 0;font-size:14px;line-height:1.6;color:var(--muted); }
  .industry-explore { display:flex;justify-content:space-between;align-items:center;gap:12px;padding-top:16px;border-top:1px solid rgba(25,24,20,.12);font-size:12px;font-weight:600;letter-spacing:.025em;color:var(--accent-dark); }
  .industry-explore > span { font-size:18px;transition:transform 220ms ease; }
  .industry-card:is(:hover,:focus-visible) { background:var(--ink);color:var(--paper);border-color:var(--ink);box-shadow:0 12px 28px rgba(25,24,20,.12);transform:translateY(-4px); }
  .industry-card:is(:hover,:focus-visible) p { color:#d6cdbc; }
  .industry-card:is(:hover,:focus-visible) .industry-number { color:var(--kraft); }
  .industry-card:is(:hover,:focus-visible) .industry-arrow { background:var(--accent);color:var(--card);border-color:var(--accent);transform:rotate(5deg); }
  .industry-card:is(:hover,:focus-visible) .industry-explore { color:var(--kraft);border-color:rgba(244,238,227,.2); }
  .industry-card:is(:hover,:focus-visible) .industry-explore > span { transform:translateX(3px); }
  .industry-card:focus-visible { outline:2px solid var(--accent);outline-offset:4px; }
  @media(max-width:1000px) { .industry-grid {grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media(max-width:600px) { .industry-grid {grid-template-columns:1fr;gap:14px;}.industry-card {min-height:230px;padding:22px;gap:20px;}.industry-card h4 {font-size:23px;} }
  @media(prefers-reduced-motion:reduce) { .industry-card,.industry-arrow,.industry-explore > span {transition:none;}.industry-card:is(:hover,:focus-visible),.industry-card:is(:hover,:focus-visible) .industry-arrow,.industry-card:is(:hover,:focus-visible) .industry-explore > span {transform:none;} }
</style>
