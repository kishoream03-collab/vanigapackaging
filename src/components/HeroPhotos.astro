---
import cakes from '../data/cakes';
import pizzas from '../data/pizzas.json';
import packaging from '../data/packaging.json';

// Use current catalogue images and titles; omit Gift bags and More bakery packaging.
const families = [
  cakes.map(p => ({ src: `/images/cakes/${p.image}`, title: p.title })),
  pizzas.map(p => ({ src: `/images/pizza/${p.image}`, title: p.title })),
  ...['burger', 'rolls', 'eco', 'cartons'].map(category =>
    packaging.filter(p => p.category === category).map(p => ({
      src: `/images/packaging/${p.image}`, title: p.title,
    })),
  ),
];
// Mix the categories so the wall represents the whole range throughout its loop.
const mixed = Array.from({ length: Math.max(...families.map(f => f.length)) }, (_, i) =>
  families.flatMap(f => f[i] ? [f[i]] : []),
).flat();
const seen = new Set<string>();
const images = mixed.filter(p => {
  if (seen.has(p.src)) return false;
  seen.add(p.src);
  return true;
});
const columns = ['up', 'down', 'up'].map((dir, i) => {
  const items = images.filter((_, index) => index % 3 === i);
  return { dir, dur: Math.max(40, items.length * 18), items };
});
---
<div class="hero-photos">
  {columns.map(col => (
    <div class="wall-col">
      <div class={`track track-${col.dir}`} style={`--dur:${col.dur}s`}>
        {[0, 1, 2].map(copy => (
          <div class="set" aria-hidden={copy > 0 ? 'true' : undefined}>
            {col.items.map((p, i) => (
              <figure class="print">
                <img src={p.src} alt={copy === 0 ? p.title : ''} width="1000" height="1000" loading={copy === 0 && i < 2 ? 'eager' : 'lazy'} draggable="false" />
                <figcaption>{p.title}</figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
<style>
  .print img { aspect-ratio:1; object-fit:contain; }
</style>
